# Ghostty terminal. https://ghostty.org/docs/config
# See every option + its default:  ghostty +show-config --default
# List themes:                     ghostty +list-themes

font-family = JetBrainsMono Nerd Font
font-size = 14

theme = Catppuccin Mocha
background = 1e1e2e 
background-opacity = 1.0

window-padding-x = 10
window-padding-y = 10
window-save-state = always

cursor-style = block
mouse-hide-while-typing = true

# Treat the macOS Option key as Alt (needed for some zsh/word bindings).
macos-option-as-alt = true

# Over SSH, install Ghostty's terminfo on the remote host on first connect,
# falling back to TERM=xterm-256color where it can't, so fresh servers don't
# fail with "'xterm-ghostty': unknown terminal type".
shell-integration-features = ssh-terminfo,ssh-env
