# ~/.zshrc — managed by chezmoi. Edit the source, then `chezmoi apply`.
#
# Load order matters:
#   1. Homebrew (macOS) onto PATH
#   2. mise activate  → puts starship/eza/fzf/zoxide/etc. on PATH
#   3. zinit + plugins
#   4. modular config (~/.config/zsh/*.zsh)
#   5. prompt + shell integrations

# ── 1. Homebrew (macOS only) ─────────────────────────────────────────
{{ if eq .chezmoi.os "darwin" -}}
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
{{- end }}

# ── 2. mise (cross-platform CLI tools) ───────────────────────────────
# Put the shims dir on PATH so mise tools resolve in NON-interactive contexts
# too (git hooks, editors, scripts). `mise activate` alone only injects tool
# paths interactively, so hooks like hk/trufflehog wouldn't find them.
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
if command -v mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi

# ── 3. zinit plugin manager (pinned for supply-chain safety) ─────────
ZINIT_PIN="v3.14.0"
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [[ ! -d "$ZINIT_HOME" ]]; then
  mkdir -p "$(dirname "$ZINIT_HOME")"
  # Retry: first-boot WSL often has DNS/network not ready.
  for _try in 1 2 3; do
    git clone --depth 1 --branch "$ZINIT_PIN" \
      https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME" && break
    print -u2 "zinit clone failed (attempt ${_try}/3)"; sleep $(( _try * 3 ))
  done
  unset _try
fi

if [[ -r "${ZINIT_HOME}/zinit.zsh" ]]; then
  source "${ZINIT_HOME}/zinit.zsh"

  # plugins
  zinit light zsh-users/zsh-autosuggestions
  zinit light zdharma-continuum/fast-syntax-highlighting
  zinit light zsh-users/zsh-completions

  # completions (load before fzf-tab)
  autoload -Uz compinit && compinit
  zinit cdreplay -q

  zinit light Aloxaf/fzf-tab
  zinit snippet OMZP::git
else
  # No zinit — report it once and keep basic Tab completion working, rather than
  # erroring on every `zinit` call below.
  print -u2 "!! zinit missing — autosuggestions/completions/highlighting disabled."
  print -u2 "!! fix network, then re-run: exec zsh   (it re-clones on startup)"
  autoload -Uz compinit && compinit
fi

# ── 4. modular config ────────────────────────────────────────────────
for _f in env history comp binds fzf aliases greeter; do
  [[ -r "${HOME}/.config/zsh/${_f}.zsh" ]] && source "${HOME}/.config/zsh/${_f}.zsh"
done
unset _f

# ── 5. prompt + integrations ─────────────────────────────────────────
{{ if not (dig "nerdFont" true .) -}}
export STARSHIP_CONFIG="$HOME/.config/starship-plain.toml"   # emoji prompt (no Nerd Font)
{{ end -}}
command -v starship &>/dev/null && eval "$(starship init zsh)"
command -v fzf      &>/dev/null && eval "$(fzf --zsh)"
# The app blocks below mutate PATH after zoxide init, which trips zoxide's
# doctor into warning on every shell start — noisy stderr that made the git
# pre-push hook panic.
export _ZO_DOCTOR=0
command -v zoxide   &>/dev/null && eval "$(zoxide init --cmd cd zsh)"

# ── 6. apps that write their own shell setup ─────────────────────────
# Herd and the dbt Fusion extension append these blocks to ~/.zshrc. They're
# kept verbatim, injection comments included, so each app finds its lines
# already present and doesn't append them again.
{{- if eq .chezmoi.os "darwin" }}


# Herd injected PHP 8.4 configuration.
export HERD_PHP_84_INI_SCAN_DIR="{{ .chezmoi.homeDir }}/Library/Application Support/Herd/config/php/84/"


# Herd injected PHP binary.
export PATH="{{ .chezmoi.homeDir }}/Library/Application Support/Herd/bin/":$PATH
# Added by dbt Fusion extension (ensure dbt binary dir on PATH)
if [[ ":$PATH:" != *":{{ .chezmoi.homeDir }}/.local/bin:"* ]]; then
  export PATH={{ .chezmoi.homeDir }}/.local/bin:"$PATH"
fi
# Added by dbt Fusion extension
alias dbtf={{ .chezmoi.homeDir }}/.local/bin/dbt


# Herd injected PHP 8.6 configuration.
export HERD_PHP_86_INI_SCAN_DIR="{{ .chezmoi.homeDir }}/Library/Application Support/Herd/config/php/86"
{{- end }}
