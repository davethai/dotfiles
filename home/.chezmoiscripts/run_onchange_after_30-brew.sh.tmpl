{{ if and (eq .chezmoi.os "darwin") (eq .profile "full") -}}
#!/usr/bin/env bash
# Install macOS GUI apps + native CLIs from the Brewfile.
# Re-runs whenever the Brewfile changes (hash below).
set -euo pipefail

# Brewfile hash: {{ include (joinPath .chezmoi.sourceDir ".." "Brewfile") | sha256sum }}

[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

brewfile="{{ joinPath .chezmoi.sourceDir ".." "Brewfile" }}"

# Homebrew 6 refuses to load formulae from third-party taps until they're
# trusted, so trust the Brewfile's taps before bundling.
for t in $(brew bundle list --tap --file="$brewfile"); do
  brew tap "$t"
  brew trust --tap "$t"
done

echo "==> brew bundle"
brew bundle --file="$brewfile"
brew bundle check --file="$brewfile"
{{- end }}
